// =========================================================================
// Survival HUD — hunger / thirst / radiation bars
// =========================================================================
// Read values set by Ravage on the player unit. Drawn via cutRsc from
// scripts\fn_survivalHUD.sqf. Three thin bars, top-left of screen.
// =========================================================================
class RscTitles {
    class RVG_SurvivalHUD {
        idd = 8001;
        duration = 1e10;
        fadein = 0;
        fadeout = 0;
        movingEnable = 0;
        enableSimulation = 1;

        onLoad   = "uiNamespace setVariable ['RVG_SurvivalHUD', _this select 0];";
        onUnload = "uiNamespace setVariable ['RVG_SurvivalHUD', nil];";

        class controls {

            class HungerBar : RscProgress {
                type = 8;
                style = 0;
                texture = "#(argb,8,8,3)color(1,1,1,1)";
                idc = 8002;

                colorFrame[] = {0, 0, 0, 0.6};
                colorBar[]   = {1, 0.6, 0.2, 0.9};

                x = 0.93 * safezoneW + safezoneX;
                y = 0.93 * safezoneH + safezoneY;
                w = 0.06 * safezoneW;
                h = 0.012 * safezoneH;
            };

            class ThirstBar : RscProgress {
                type = 8;
                style = 0;
                texture = "#(argb,8,8,3)color(1,1,1,1)";
                idc = 8004;

                colorFrame[] = {0, 0, 0, 0.6};
                colorBar[]   = {0.3, 0.6, 1, 0.9};

                x = 0.93 * safezoneW + safezoneX;
                y = 0.948 * safezoneH + safezoneY;
                w = 0.06 * safezoneW;
                h = 0.012 * safezoneH;
            };

            class RadBar : RscProgress {
                type = 8;
                style = 0;
                texture = "#(argb,8,8,3)color(1,1,1,1)";
                idc = 8006;

                colorFrame[] = {0, 0, 0, 0.6};
                colorBar[]   = {0.7, 1, 0.3, 0.9};

                x = 0.93 * safezoneW + safezoneX;
                y = 0.966 * safezoneH + safezoneY;
                w = 0.06 * safezoneW;
                h = 0.012 * safezoneH;
            };
        };
    };
};